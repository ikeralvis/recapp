---
import AppShell from '../../layouts/AppShell.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { Sparkles, Users } from '@lucide/astro';
import { listAccessibleCategories } from '../../lib/categoryAccess';

const userId = Astro.locals.user!.id;
const myCategories = await listAccessibleCategories(userId);

const CARD_STYLES = [
	'from-blue-500 to-cyan-400',
	'from-violet-500 to-fuchsia-400',
	'from-amber-500 to-orange-400',
	'from-emerald-500 to-teal-400',
	'from-rose-500 to-pink-400',
	'from-indigo-500 to-sky-400',
];
---

<AppShell title="RecApp" active="home">
	<header class="flex items-center justify-between px-6 pt-8 pb-5">
		<div>
			<p class="text-sm font-medium text-slate-500">Hola,</p>
			<h1 class="font-display text-2xl font-extrabold text-slate-900">{Astro.locals.user?.name}</h1>
		</div>
		<a
			href="/app/categories"
			class="rounded-full bg-white px-3 py-2 text-sm font-semibold text-blue-600 shadow-sm ring-1 ring-sky-100"
		>
			Gestionar
		</a>
	</header>

	<section class="px-6">
		{
			myCategories.length === 0 ? (
				<div class="flex flex-col items-center gap-3 rounded-3xl bg-white px-6 py-10 text-center shadow-sm ring-1 ring-sky-100">
					<span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600">
						<Sparkles size={24} />
					</span>
					<p class="font-display text-lg font-bold text-slate-800">Crea tu primera categoría</p>
					<p class="text-sm text-slate-500">Restaurantes, viajes, lo que quieras registrar.</p>
					<a
						href="/app/categories/new"
						class="mt-2 rounded-full bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-600/30"
					>
						Nueva categoría
					</a>
				</div>
			) : (
				<div class="grid grid-cols-2 gap-3">
					{myCategories.map((c, i) => (
						<a
							href={`/app/categories/${c.id}`}
							class={`flex flex-col gap-2 rounded-3xl bg-linear-to-br p-4 text-white shadow-lg transition active:scale-[0.97] ${CARD_STYLES[i % CARD_STYLES.length]}`}
						>
							<div class="flex items-center justify-between">
								<CategoryIcon name={c.icon} class="h-7 w-7" />
								{c.ownerType === 'group' && <Users size={14} class="text-white/80" />}
							</div>
							<span class="font-display font-bold leading-tight">{c.name}</span>
							<span class="text-xs font-medium text-white/80">{c.kind === 'counter' ? 'Contador' : 'Detallada'}</span>
						</a>
					))}
				</div>
			)
		}
	</section>
</AppShell>
