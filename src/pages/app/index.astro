---
import AppShell from '../../layouts/AppShell.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import QuickAddModal from '../../components/QuickAddModal';
import { Sparkles, Users, History } from '@lucide/astro';
import { listAccessibleCategories, isPersonalView } from '../../lib/categoryAccess';
import { db } from '../../db/client';
import { entries } from '../../db/schema';
import { and, eq, gte, inArray, sql } from 'drizzle-orm';
import type { CategoryField } from '../../lib/categoryField';
import { AVATAR_COLORS, isAvatarColor, DEFAULT_AVATAR_COLOR } from '../../lib/avatarColors';

const userId = Astro.locals.user!.id;
const myCategories = await listAccessibleCategories(userId);

const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);

const counterCategories = myCategories.filter((c) => c.kind === 'counter');
const personalIds = counterCategories.filter((c) => isPersonalView(c)).map((c) => c.id);
const sharedIds = counterCategories.filter((c) => !isPersonalView(c)).map((c) => c.id);

const countByCategory = new Map<number, number>();
if (personalIds.length) {
	const rows = await db
		.select({ categoryId: entries.categoryId, total: sql<number>`count(*)` })
		.from(entries)
		.where(and(inArray(entries.categoryId, personalIds), eq(entries.userId, userId), gte(entries.occurredAt, startOfToday)))
		.groupBy(entries.categoryId);
	for (const r of rows) countByCategory.set(r.categoryId, r.total);
}
if (sharedIds.length) {
	const rows = await db
		.select({ categoryId: entries.categoryId, total: sql<number>`count(*)` })
		.from(entries)
		.where(and(inArray(entries.categoryId, sharedIds), gte(entries.occurredAt, startOfToday)))
		.groupBy(entries.categoryId);
	for (const r of rows) countByCategory.set(r.categoryId, r.total);
}

const detailedCategoriesData = myCategories
	.filter((c) => c.kind === 'detailed')
	.map((c) => ({
		id: c.id,
		name: c.name,
		icon: c.icon,
		fields: c.schemaJson as unknown as CategoryField[],
	}));

function cardGradient(color: string) {
	return isAvatarColor(color) ? AVATAR_COLORS[color] : AVATAR_COLORS[DEFAULT_AVATAR_COLOR];
}
---

<AppShell title="RecApp" active="home">
	<header class="flex items-center justify-between px-6 pt-8 pb-5">
		<div>
			<p class="text-sm font-medium text-slate-500">Hola,</p>
			<h1 class="font-display text-2xl font-extrabold text-slate-900">{Astro.locals.user?.name}</h1>
		</div>
		<a
			href="/app/categories"
			class="rounded-full bg-white px-3 py-2 text-sm font-semibold text-blue-600 shadow-sm ring-1 ring-sky-100"
		>
			Gestionar
		</a>
	</header>

	<section class="px-6">
		{
			myCategories.length === 0 ? (
				<div class="flex flex-col items-center gap-3 rounded-3xl bg-white px-6 py-10 text-center shadow-sm ring-1 ring-sky-100">
					<span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600">
						<Sparkles size={24} />
					</span>
					<p class="font-display text-lg font-bold text-slate-800">Crea tu primera categoría</p>
					<p class="text-sm text-slate-500">Restaurantes, viajes, lo que quieras registrar.</p>
					<a
						href="/app/categories/new"
						class="mt-2 rounded-full bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-600/30"
					>
						Nueva categoría
					</a>
				</div>
			) : (
				<div class="grid grid-cols-2 gap-3">
					{myCategories.map((c) =>
						c.kind === 'counter' ? (
							<button
								type="button"
								data-counter-card
								data-category-id={c.id}
								class={`quick-counter-card relative flex flex-col gap-2 rounded-3xl bg-linear-to-br p-4 text-left text-white shadow-lg transition active:scale-[0.97] ${cardGradient(c.color)}`}
							>
								<CategoryIcon name={c.icon} class="h-7 w-7" />
								<span class="flex items-center gap-1 font-display font-bold leading-tight">
									{c.name}
									{c.ownerType === 'group' && <Users size={13} class="shrink-0 text-white/70" />}
								</span>
								<span class="flex items-baseline gap-1 text-xs font-medium text-white/80">
									<span class="quick-counter-total font-display text-base font-extrabold text-white">
										{countByCategory.get(c.id) ?? 0}
									</span>
									hoy · toca para +1
								</span>
								<a
									href={`/app/categories/${c.id}`}
									aria-label="Ver historial"
									class="absolute right-3 top-3 rounded-full bg-white/15 p-1.5 hover:bg-white/25"
								>
									<History size={14} />
								</a>
							</button>
						) : (
							<button
								type="button"
								data-quick-add-card
								data-category-id={c.id}
								class={`relative flex flex-col gap-2 rounded-3xl bg-linear-to-br p-4 text-left text-white shadow-lg transition active:scale-[0.97] ${cardGradient(c.color)}`}
							>
								<CategoryIcon name={c.icon} class="h-7 w-7" />
								<span class="flex items-center gap-1 font-display font-bold leading-tight">
									{c.name}
									{c.ownerType === 'group' && <Users size={13} class="shrink-0 text-white/70" />}
								</span>
								<span class="text-xs font-medium text-white/80">Toca para registrar</span>
								<a
									href={`/app/categories/${c.id}`}
									aria-label="Ver historial"
									class="absolute right-3 top-3 rounded-full bg-white/15 p-1.5 hover:bg-white/25"
								>
									<History size={14} />
								</a>
							</button>
						)
					)}
				</div>
			)
		}
	</section>

	<QuickAddModal client:load categories={detailedCategoriesData} />

	<script>
		import { toast } from 'sonner';

		// Delegado en document (no en cada card): así sigue funcionando tras cada
		// navegación con View Transitions, que reemplaza el DOM pero no re-ejecuta
		// este script. Antes, con listeners por card, dejaba de abrir el popup
		// en móvil tras volver a Home desde otra pantalla.
		document.addEventListener('click', async (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('a')) return;

			const quickAddCard = target.closest<HTMLButtonElement>('[data-quick-add-card]');
			if (quickAddCard) {
				window.dispatchEvent(
					new CustomEvent('recapp:open-quick-add', { detail: { categoryId: Number(quickAddCard.dataset.categoryId) } })
				);
				return;
			}

			const counterCard = target.closest<HTMLButtonElement>('[data-counter-card]');
			if (counterCard) {
				const categoryId = counterCard.dataset.categoryId;
				counterCard.disabled = true;

				const res = await fetch('/api/entries', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ categoryId: Number(categoryId) }),
				});

				counterCard.disabled = false;

				if (!res.ok) {
					const body = await res.json().catch(() => ({}));
					toast.error(body.error ?? 'No se ha podido registrar.');
					return;
				}

				const totalEl = counterCard.querySelector('.quick-counter-total');
				const newTotal = totalEl ? Number(totalEl.textContent) + 1 : null;
				if (totalEl && newTotal !== null) totalEl.textContent = String(newTotal);
				toast.success(newTotal !== null ? `Hoy: ${newTotal}` : 'Registrado');
			}
		});
	</script>
</AppShell>
