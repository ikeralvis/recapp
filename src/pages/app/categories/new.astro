---
import AppShell from '../../../layouts/AppShell.astro';
import CategoryForm from '../../../components/CategoryForm';
import BackLink from '../../../components/BackLink.astro';
---

<AppShell title="Nueva categoría — RecApp" active="home">
	<header class="px-6 pt-8 pb-5">
		<BackLink fallback="/app/categories" />
		<h1 class="font-display text-2xl font-extrabold text-slate-900">Nueva categoría</h1>
	</header>
	<section class="px-6">
		<div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-sky-100">
			<CategoryForm client:load />
		</div>
	</section>
</AppShell>
