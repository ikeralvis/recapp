---
import AppShell from '../../../../layouts/AppShell.astro';
import CategoryIcon from '../../../../components/CategoryIcon.astro';
import CounterButton from '../../../../components/CounterButton';
import EntryForm from '../../../../components/EntryForm';
import EntryHistory from '../../../../components/EntryHistory';
import BackLink from '../../../../components/BackLink.astro';
import { Pencil } from '@lucide/astro';
import { and, eq, gte, sql } from 'drizzle-orm';
import { db } from '../../../../db/client';
import { categories, entries } from '../../../../db/schema';
import { canAccessCategory, isPersonalView } from '../../../../lib/categoryAccess';
import type { CategoryField } from '../../../../lib/categoryField';

const userId = Astro.locals.user!.id;
const id = Number(Astro.params.id);

const category = Number.isInteger(id) ? await db.select().from(categories).where(eq(categories.id, id)).get() : null;

if (!category || !(await canAccessCategory(userId, category))) {
	return Astro.redirect('/app/categories');
}

const fields = category.kind === 'detailed' ? (category.schemaJson as unknown as CategoryField[]) : [];
const personalOnly = isPersonalView(category);

let todayTotal = 0;
let lifetimeTotal = 0;
if (category.kind === 'counter') {
	const startOfToday = new Date();
	startOfToday.setHours(0, 0, 0, 0);

	const scopeCondition = personalOnly ? and(eq(entries.categoryId, category.id), eq(entries.userId, userId)) : eq(entries.categoryId, category.id);

	const lifetimeResult = await db.select({ count: sql<number>`count(*)` }).from(entries).where(scopeCondition).get();
	const todayResult = await db
		.select({ count: sql<number>`count(*)` })
		.from(entries)
		.where(and(scopeCondition, gte(entries.occurredAt, startOfToday)))
		.get();

	lifetimeTotal = lifetimeResult?.count ?? 0;
	todayTotal = todayResult?.count ?? 0;
}
---

<AppShell title={`${category.name} — RecApp`} active="home">
	<header class="flex items-center justify-between px-6 pt-8 pb-5">
		<BackLink fallback="/app" />
		<a href={`/app/categories/${category.id}/edit`} class="rounded-full bg-white p-2 text-slate-500 shadow-sm ring-1 ring-sky-100">
			<Pencil size={16} />
		</a>
	</header>

	<section class="flex flex-col gap-5 px-6 pb-6">
		<div class="flex items-center gap-3">
			<span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
				<CategoryIcon name={category.icon} class="h-6 w-6" />
			</span>
			<h1 class="font-display text-2xl font-extrabold text-slate-900">{category.name}</h1>
		</div>

		{
			category.kind === 'counter' ? (
				<CounterButton client:load categoryId={category.id} initialToday={todayTotal} initialTotal={lifetimeTotal} />
			) : (
				<EntryForm client:load categoryId={category.id} fields={fields} />
			)
		}

		<div class="flex flex-col gap-2">
			<p class="text-sm font-semibold text-slate-700">{personalOnly ? 'Tu historial' : 'Historial'}</p>
			<EntryHistory
				client:load
				categoryId={category.id}
				fields={fields}
				showAuthor={!personalOnly}
				currentUserId={userId}
			/>
		</div>
	</section>
</AppShell>
