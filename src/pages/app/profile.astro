---
import AppShell from '../../layouts/AppShell.astro';
import GroupsPanel from '../../components/GroupsPanel';
import ReminderToggle from '../../components/ReminderToggle';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { Trophy } from '@lucide/astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../db/client';
import { categories, trophies, users } from '../../db/schema';
import { AVATAR_COLORS, isAvatarColor, DEFAULT_AVATAR_COLOR } from '../../lib/avatarColors';

const { user } = Astro.locals;
const fullUser = user ? await db.select().from(users).where(eq(users.id, user.id)).get() : null;
const currentColor = fullUser && isAvatarColor(fullUser.avatarColor) ? fullUser.avatarColor : DEFAULT_AVATAR_COLOR;

const myTrophies = user
	? await db
			.select({ period: trophies.period, value: trophies.value, categoryName: categories.name, categoryIcon: categories.icon })
			.from(trophies)
			.innerJoin(categories, eq(categories.id, trophies.categoryId))
			.where(eq(trophies.winnerUserId, user.id))
			.orderBy(desc(trophies.period))
			.limit(12)
	: [];
---

<AppShell title="Perfil — RecApp" active="profile">
	<header class="flex flex-col items-center gap-2 px-6 pt-10 pb-6">
		<div
			id="avatar-preview"
			class:list={['flex h-20 w-20 items-center justify-center rounded-full bg-linear-to-br font-display text-3xl font-extrabold text-white shadow-lg', AVATAR_COLORS[currentColor]]}
		>
			{user?.name?.[0]?.toUpperCase()}
		</div>
		<h1 class="font-display text-xl font-extrabold text-slate-900">{user?.name}</h1>
		<p class="text-sm text-slate-500">{user?.email}</p>
	</header>

	{
		myTrophies.length > 0 && (
			<section class="px-6 pb-4">
				<p class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-slate-700">
					<Trophy size={16} class="text-amber-500" /> Copas ganadas
				</p>
				<div class="flex gap-2 overflow-x-auto pb-1">
					{myTrophies.map((t) => (
						<div class="flex shrink-0 flex-col items-center gap-1 rounded-2xl bg-amber-50 px-3 py-2 text-center">
							<span class="flex h-8 w-8 items-center justify-center rounded-full bg-amber-100 text-amber-600">
								<CategoryIcon name={t.categoryIcon} class="h-4 w-4" />
							</span>
							<span class="max-w-20 truncate text-xs font-semibold text-slate-700">{t.categoryName}</span>
							<span class="text-[10px] font-medium text-slate-400">{t.period}</span>
						</div>
					))}
				</div>
			</section>
		)
	}

	<section class="flex flex-col gap-4 px-6">
		<form id="profile-form" class="flex flex-col gap-3 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-sky-100">
			<label class="flex flex-col gap-1 text-sm font-semibold text-slate-700">
				Nombre
				<input
					name="name"
					value={user?.name}
					required
					class="rounded-2xl border-2 border-sky-100 bg-white px-4 py-3 font-medium text-slate-900 outline-none transition focus:border-blue-500"
				/>
			</label>

			<div class="flex flex-col gap-1 text-sm font-semibold text-slate-700">
				Color de avatar
				<input type="hidden" name="avatarColor" id="avatar-color-input" value={currentColor} />
				<div class="flex gap-2">
					{Object.entries(AVATAR_COLORS).map(([key, gradient]) => (
						<button
							type="button"
							data-avatar-swatch={key}
							aria-label={key}
							class:list={[
								'avatar-swatch h-9 w-9 rounded-full bg-linear-to-br transition',
								gradient,
								key === currentColor ? 'ring-2 ring-offset-2 ring-blue-500' : '',
							]}
						/>
					))}
				</div>
			</div>

			<button
				type="submit"
				class="rounded-2xl bg-blue-600 px-4 py-3 font-bold text-white shadow-lg shadow-blue-600/30 transition hover:bg-blue-700 active:scale-[0.98]"
			>
				Guardar cambios
			</button>
		</form>

		<ReminderToggle client:load />

		<GroupsPanel client:load />

		<button
			id="logout-btn"
			class="rounded-2xl border-2 border-red-100 px-4 py-3 text-center font-semibold text-red-500 hover:bg-red-50"
		>
			Cerrar sesión
		</button>
	</section>

	<script>
		import { toast } from 'sonner';

		const form = document.getElementById('profile-form') as HTMLFormElement;
		const colorInput = document.getElementById('avatar-color-input') as HTMLInputElement;
		const preview = document.getElementById('avatar-preview')!;

		document.querySelectorAll<HTMLButtonElement>('.avatar-swatch').forEach((btn) => {
			btn.addEventListener('click', () => {
				const color = btn.dataset.avatarSwatch!;
				colorInput.value = color;

				document.querySelectorAll('.avatar-swatch').forEach((b) => b.classList.remove('ring-2', 'ring-offset-2', 'ring-blue-500'));
				btn.classList.add('ring-2', 'ring-offset-2', 'ring-blue-500');

				preview.className = preview.className.replace(/from-\S+ to-\S+/, '');
				preview.classList.add(...btn.className.split(' ').filter((c) => c.startsWith('from-') || c.startsWith('to-')));
			});
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form));

			const res = await fetch('/api/profile', {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(data),
			});

			const body = await res.json().catch(() => ({}));
			if (res.ok) {
				toast.success('Perfil actualizado');
			} else {
				toast.error(body.error ?? 'Algo ha ido mal.');
			}
		});

		document.getElementById('logout-btn')?.addEventListener('click', async () => {
			await fetch('/api/auth/logout', { method: 'POST' });
			window.location.href = '/login';
		});
	</script>
</AppShell>
