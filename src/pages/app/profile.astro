---
import AppShell from '../../layouts/AppShell.astro';
import GroupsPanel from '../../components/GroupsPanel';
import ReminderToggle from '../../components/ReminderToggle';
import ProfileForm from '../../components/ProfileForm';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { Trophy } from '@lucide/astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../db/client';
import { categories, trophies, users } from '../../db/schema';
import { isAvatarColor, DEFAULT_AVATAR_COLOR } from '../../lib/avatarColors';
import { isDicebearStyle } from '../../lib/avatar';

const { user } = Astro.locals;
const fullUser = user ? await db.select().from(users).where(eq(users.id, user.id)).get() : null;
const currentColor = fullUser && isAvatarColor(fullUser.avatarColor) ? fullUser.avatarColor : DEFAULT_AVATAR_COLOR;
const currentStyle = fullUser?.avatarStyle && isDicebearStyle(fullUser.avatarStyle) ? fullUser.avatarStyle : null;
const currentAccent = fullUser && isAvatarColor(fullUser.accentColor) ? fullUser.accentColor : DEFAULT_AVATAR_COLOR;

const myTrophies = user
	? await db
			.select({ period: trophies.period, value: trophies.value, categoryName: categories.name, categoryIcon: categories.icon })
			.from(trophies)
			.innerJoin(categories, eq(categories.id, trophies.categoryId))
			.where(eq(trophies.winnerUserId, user.id))
			.orderBy(desc(trophies.period))
			.limit(12)
	: [];
---

<AppShell title="Perfil — RecApp" active="profile">
	<header class="flex flex-col items-center gap-1 px-6 pt-10 pb-4 text-center">
		<p class="text-sm text-slate-500">{user?.email}</p>
	</header>

	{
		myTrophies.length > 0 && (
			<section class="px-6 pb-4">
				<p class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-slate-700">
					<Trophy size={16} class="text-amber-500" /> Copas ganadas
				</p>
				<div class="flex gap-2 overflow-x-auto pb-1">
					{myTrophies.map((t) => (
						<div class="flex shrink-0 flex-col items-center gap-1 rounded-2xl bg-amber-50 px-3 py-2 text-center">
							<span class="flex h-8 w-8 items-center justify-center rounded-full bg-amber-100 text-amber-600">
								<CategoryIcon name={t.categoryIcon} class="h-4 w-4" />
							</span>
							<span class="max-w-20 truncate text-xs font-semibold text-slate-700">{t.categoryName}</span>
							<span class="text-[10px] font-medium text-slate-400">{t.period}</span>
						</div>
					))}
				</div>
			</section>
		)
	}

	<section class="flex flex-col gap-4 px-6 pb-6">
		<ProfileForm
			client:load
			initialName={user?.name ?? ''}
			initialColor={currentColor}
			initialStyle={currentStyle}
			initialSeed={fullUser?.avatarSeed ?? ''}
			initialAccent={currentAccent}
		/>

		<ReminderToggle client:load />

		<GroupsPanel client:load />

		<button
			id="logout-btn"
			class="rounded-2xl border-2 border-red-100 px-4 py-3 text-center font-semibold text-red-500 hover:bg-red-50"
		>
			Cerrar sesión
		</button>
	</section>

	<script>
		document.getElementById('logout-btn')?.addEventListener('click', async () => {
			await fetch('/api/auth/logout', { method: 'POST' });
			window.location.href = '/login';
		});
	</script>
</AppShell>
