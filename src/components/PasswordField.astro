---
interface Props {
	label: string;
	name?: string;
	id?: string;
	autocomplete?: string;
	showStrength?: boolean;
}

const { label, name = 'password', id = name, autocomplete = 'new-password', showStrength = false } = Astro.props;
---

<div class="password-field flex flex-col gap-1 text-sm font-semibold text-slate-700">
	<label for={id}>{label}</label>
	<div class="relative">
		<input
			type="password"
			name={name}
			id={id}
			required
			autocomplete={autocomplete}
			class="password-input w-full rounded-2xl border-2 border-sky-100 bg-white px-4 py-3 pr-12 font-medium text-slate-900 outline-none transition focus:border-blue-500"
		/>
		<button
			type="button"
			class="password-toggle absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-blue-600"
			aria-label="Mostrar contraseña"
		>
			<svg class="eye-open h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
				<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
			</svg>
			<svg class="eye-closed hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.774 3.162 10.066 7.498a10.522 10.522 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
			</svg>
		</button>
	</div>
	{
		showStrength && (
			<ul class="password-strength mt-1 grid grid-cols-2 gap-x-3 gap-y-0.5 text-xs font-medium text-slate-400">
				<li data-rule="length" class="transition-colors">8+ caracteres</li>
				<li data-rule="letter" class="transition-colors">Una letra</li>
				<li data-rule="number" class="transition-colors">Un número</li>
				<li data-rule="special" class="transition-colors">Un carácter especial</li>
			</ul>
		)
	}
</div>

<script>
	function setupPasswordField(field: Element) {
		const input = field.querySelector<HTMLInputElement>('.password-input')!;
		const toggle = field.querySelector<HTMLButtonElement>('.password-toggle')!;
		const eyeOpen = field.querySelector('.eye-open')!;
		const eyeClosed = field.querySelector('.eye-closed')!;

		toggle.addEventListener('click', () => {
			const show = input.type === 'password';
			input.type = show ? 'text' : 'password';
			eyeOpen.classList.toggle('hidden', show);
			eyeClosed.classList.toggle('hidden', !show);
			toggle.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
		});

		const strengthList = field.querySelector('.password-strength');
		if (!strengthList) return;

		const rules: Record<string, RegExp> = {
			length: /.{8,}/,
			letter: /[a-zA-Z]/,
			number: /[0-9]/,
			special: /[^a-zA-Z0-9]/,
		};

		input.addEventListener('input', () => {
			for (const [rule, pattern] of Object.entries(rules)) {
				const item = strengthList.querySelector(`[data-rule="${rule}"]`);
				const passed = pattern.test(input.value);
				item?.classList.toggle('text-green-600', passed);
				item?.classList.toggle('text-slate-400', !passed);
			}
		});
	}

	document.querySelectorAll('.password-field').forEach(setupPasswordField);
</script>
