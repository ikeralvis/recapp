---
import '../styles/global.css';
import Toaster from '../components/Toaster';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
}

const { title = 'RecApp' } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2563eb" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-sky-50 font-sans text-slate-900">
		<slot />
		<Toaster client:load />
	</body>
</html>
