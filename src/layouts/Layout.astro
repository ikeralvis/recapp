---
import '../styles/global.css';
import Toaster from '../components/Toaster';
import { ClientRouter } from 'astro:transitions';
import { ACCENT_HEX, isAvatarColor, DEFAULT_AVATAR_COLOR } from '../lib/avatarColors';

interface Props {
	title?: string;
}

const { title = 'RecApp' } = Astro.props;
const rawAccent = Astro.locals.user?.accentColor ?? '';
const accentColor = isAvatarColor(rawAccent) ? rawAccent : DEFAULT_AVATAR_COLOR;
---

<html lang="es" data-accent={accentColor}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content={ACCENT_HEX[accentColor]} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-sky-50 font-sans text-slate-900">
		<div id="recapp-progress"></div>
		<slot />
		<Toaster client:load />
		<script>
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/sw.js').catch(() => {
					// el registro puede fallar en navegadores sin soporte; no es crítico
				});
			}

			const bar = document.getElementById('recapp-progress');
			let showTimer: ReturnType<typeof setTimeout> | undefined;

			document.addEventListener('astro:before-preparation', () => {
				// Solo se muestra si la navegación tarda más de 150ms: evita el
				// parpadeo en transiciones rápidas dentro de la misma red local.
				showTimer = setTimeout(() => {
					bar?.classList.remove('is-done');
					bar?.classList.add('is-active');
				}, 150);
			});

			document.addEventListener('astro:after-swap', () => {
				clearTimeout(showTimer);
				bar?.classList.remove('is-active');
				bar?.classList.add('is-done');
				setTimeout(() => bar?.classList.remove('is-done'), 250);
			});
		</script>
	</body>
</html>
